# Private container network URL; never NEXT_PUBLIC_ and never browser-accessible.
RAGA_CORE_URL=http://backend:8000
# Use only for static demo/visual review, NEVER on a public deployment.
RAGA_DEMO_MODE=false
# Used for same-origin form origin validation at reverse proxy.
RAGA_SITE_ORIGIN=https://raga7.vodopetov.ru
